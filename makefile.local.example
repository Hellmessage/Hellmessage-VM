# 复制为 makefile.local (已 gitignore) 并填入真实值. 切勿入库任何凭据.
# 主 Makefile 通过 -include makefile.local 引入.

# macOS 签名 + 公证 (make package-mac / notarize-mac). 证书需已装入本机钥匙串.
# NOTARIZE_PASS 用 App 专用密码 (appleid.apple.com 生成), 非账号密码.
MACOS_CODESIGN_IDENTITY := Developer ID Application: Your Name (TEAMID)
MACOS_NOTARIZE_USER     := you@example.com
MACOS_NOTARIZE_PASS     := xxxx-xxxx-xxxx-xxxx
MACOS_NOTARIZE_TEAM_ID  := TEAMID

# Apple 开发团队 ID: 构建 xcode 工程时注入 DEVELOPMENT_TEAM (自动签名), 免去每次 Xcode 手选.
APPLE_DEV_TEAM := TEAMID
