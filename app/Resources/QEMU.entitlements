<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- QEMU 子进程使用 Apple Hypervisor.framework 加速 aarch64-on-aarch64 (HVF) 必需 -->
    <!-- QEMU 二进制独立用 hypervisor entitlement; HVM 主进程已无 virtualization (QEMU-only) -->
    <key>com.apple.security.hypervisor</key>
    <true/>
</dict>
</plist>
